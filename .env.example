# .env.example — Variables de Entorno para el Sistema de Scraping, IA y Automatización
# Saladillo Vivo (Next.js 15 + Supabase)

# ==============================================================================
# 1. CONFIGURACIÓN DE SUPABASE (Base de datos y backend de Next.js)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://otwvfihzaznyjvjtkvvd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anonima_aqui
# Opcional para bypass de RLS (clave de servicio administrativo):
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
SUPABASE_KEY=tu_service_role_key_aqui

# ==============================================================================
# 2. CONFIGURACIÓN DE IA (Estrategia Free-First: GLM -> Gemini -> OpenAI)
# ==============================================================================
# Proveedor 1 (Primario / Free permanente): Zhipu AI / Z.AI
# Obtener en: https://open.bigmodel.cn/
GLM_API_KEY=tu_glm_api_key_aqui
GLM_MODEL=glm-4-flash

# Proveedor 2 (Secundario / Free con excelentes cuotas): Google AI Studio
# Obtener en: https://aistudio.google.com/
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Proveedor 3 (Terciario / Fallback de pago comercial): OpenAI
# Obtener en: https://platform.openai.com/
OPENAI_API_KEY=tu_openai_api_key_aqui
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# 3. AUTOMATIZACIONES Y WEBHOOKS (Make.com, Vercel Cron)
# ==============================================================================
CRON_SECRET=tu_secreto_para_cron_jobs
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/tu_webhook_aqui

# ==============================================================================
# 4. CONFIGURACIÓN DE LOGS DEL ORQUESTADOR
# ==============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/automation.log
